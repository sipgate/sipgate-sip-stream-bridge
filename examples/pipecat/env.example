# --- Pipecat bot -----------------------------------------------------------

# echo  = dependency-free, echoes the caller's audio (no API keys needed).
# voice = STT -> LLM -> TTS voice agent (needs the keys below).
BOT_MODE=echo

# Port the bot's WebSocket server listens on. The bridge's WS_TARGET_URL must
# point here (see README): ws://localhost:8765/ws
PORT=8765

# --- voice mode only -------------------------------------------------------
# DEEPGRAM_API_KEY=
# GOOGLE_API_KEY=
# CARTESIA_API_KEY=

# --- optional: let the bot hang up the call itself -------------------------
# The bridge exposes a Twilio-compatible REST control plane, so the standard
# TwilioFrameSerializer hang-up works against it — no Twilio account. Set all
# three to enable auto_hang_up (Go implementation of the bridge):
#   BRIDGE_BASE_URL   = the bridge's HTTP endpoint (default port 9090)
#   BRIDGE_ACCOUNT_SID= the bridge's synthesised AccountSid ("AC" + first 32
#                       chars of sha256(SIP_USER)); shown in the bridge's /ui
#   BRIDGE_AUTH_TOKEN = the bridge's AUTH_TOKEN
# BRIDGE_BASE_URL=http://localhost:9090
# BRIDGE_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BRIDGE_AUTH_TOKEN=your-bridge-auth-token
